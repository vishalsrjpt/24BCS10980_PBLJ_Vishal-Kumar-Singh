# CUFind (Chandigarh University) Environment Variables Configuration

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projdb
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Server Configuration
PORT=8081

# JWT Authentication (replace with a strong 256+ bit secret in production)
JWT_SECRET=CUFindSecretKeyForJwtAuthenticationSuperSecure384BitStringHere!
JWT_EXPIRATION_MS=86400000

# File Upload Storage Directory
UPLOAD_DIR=uploads

# Super Admin Bootstrap Credentials (change in production)
SUPERADMIN_EMAIL=admin@gmail.com
SUPERADMIN_PASSWORD=change_me_in_production
SUPERADMIN_NAME=System Super Admin

# Optional SMTP Mail Configuration (Disabled by default)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
